    <application
        android:allowBackup="true"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="slick"
        android:supportsRtl="true"



        <meta-data
            android:name="com.slick.browser.BUILD_SIGNATURE"
            android:value="/* First worked operational APK build compiled on 28.10.26 by Argon */" />

        <meta-data
